<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NOVA" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/nova_accent</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/nova_bg</item>
        <item name="android:navigationBarColor">@color/nova_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
